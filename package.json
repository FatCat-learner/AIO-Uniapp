    "preview:prod": "node scripts/mini-ci.js preview prod",
    "upload:test": "node scripts/mini-ci.js upload test",
    "upload:prod": "node scripts/mini-ci.js upload prod",
    "typecheck": "vue-tsc --noEmit",
